# Required
GEMINI_API_KEY=paste_your_key_here

# Defaults
GEMINI_MODEL=gemini-2.5-flash
MAX_AGENT_STEPS=4
MAX_OUTPUT_TOKENS=2048
MAX_RUN_COST_USD=0.05

# Optional pricing
# Leave both blank unless you have checked the current official prices.
# Blank values show cost as unavailable; analysis still works.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
